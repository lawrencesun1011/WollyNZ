# 目标架构：Cloudflare Pages（静态托管）+ Supabase（认证 + 数据库）
# 复制为 .env.local 后填写，.env* 已被 .gitignore 忽略，不会提交。
#
# ---------- Supabase ----------
# 获取：Supabase Dashboard → Project Settings → API Keys
# Project URL（形如 https://xxxxxxxx.supabase.co）：前端可见，公开安全
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key：前端可见，实际权限由表级 RLS 控制
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# ---------- AI 代理（Cloudflare Worker，见 workers/ai-proxy/）----------
# Worker 部署后拿到的访问地址；前端经它调用第三方模型，API Key 不下发到浏览器
NEXT_PUBLIC_AI_PROXY_URL=
#
# ---------- 迁移过渡期：CloudBase（旧栈，全部迁完后整段删除）----------
# 获取：CloudBase 控制台 → 应用认证 → 密钥管理
# envId：你的环境 ID

CLOUDBASE_ENV_ID=test-d3gqp6tfx48ae40f2

# API Key（service_role，写入数据用，仅在后端/脚本使用，切勿暴露到前端）
CLOUDBASE_API_KEY=

# Publishable Key（anon，前端/服务端只读查询用）
CLOUDBASE_PUBLISHABLE_KEY=

# 前端可见（NEXT_PUBLIC_）：仅客户端 @cloudbase/js-sdk 初始化用，仅含匿名/邮箱登录权限，切勿填入 API Key
NEXT_PUBLIC_CLOUDBASE_ENV_ID=test-d3gqp6tfx48ae40f2
NEXT_PUBLIC_CLOUDBASE_PUBLISHABLE_KEY=
